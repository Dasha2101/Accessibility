{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",

    "rootDir": "src",
    "outDir": "dist",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "jsx": "react-jsx",

    "strict": true,
    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true
  },

  "include": [
  "src/services/**/*",
  "src/browser/**/*",
  "src/modules/**/*",
  "src/types/**/*",
  "src/utils/**/*"
  ],
  
  "exclude": ["node_modules", "dist"]
}